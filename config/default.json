{
  "openapiConfig": {
    "filePath": "./openapi3.yaml",
    "basePath": "/docs",
    "rawPath": "/api",
    "uiPath": "/api"
  },
  "telemetry": {
    "metrics": {},
    "tracing": {
      "isEnabled": false
    },
    "shared": {},
    "logger": {
      "level": "info",
      "prettyPrint": false,
      "opentelemetryOptions": {
        "enabled": false
      }
    }
  },
  "server": {
    "port": 8080
  },
  "db": {
    "type": "postgres",
    "host": "localhost",
    "port": 5432,
    "username": "myuser",
    "password": "mypassword",
    "database": "mydatabase",
    "schema": "public",
    "synchronize": true,
    "logging": false
  },
  "response": {
    "compression": {
      "enabled": true,
      "options": null
    }
  }
}
